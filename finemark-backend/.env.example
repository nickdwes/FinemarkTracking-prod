PORT=3000
NODE_ENV=production

# ── Frontend origin (used for CORS and SSO redirect) ─────────────────────────
# When running via docker-compose this should be your public-facing host/port.
CORS_ORIGIN=http://localhost:5500
FRONTEND_URL=http://localhost:5500

# ── JWT ───────────────────────────────────────────────────────────────────────
JWT_SECRET=CHANGE_ME
JWT_EXPIRES_IN=15m
REFRESH_EXPIRES_DAYS=7

# ── PostgreSQL ────────────────────────────────────────────────────────────────
# When using docker-compose leave PG_HOST=db (service name).
# For a standalone .env against a local Postgres use PG_HOST=127.0.0.1
PG_HOST=db
PG_PORT=5432
PG_DATABASE=finemark_backend
PG_USER=finemark
PG_PASSWORD=CHANGE_ME

# ── Docker-compose port ───────────────────────────────────────────────────────
FRONTEND_PORT=5500

# ── Azure AD / Microsoft Entra ID ─────────────────────────────────────────────
# Shared with Microsoft Graph services (mail, user provisioning) and SSO.
GRAPH_TENANT_ID=YOUR_TENANT_ID
GRAPH_CLIENT_ID=YOUR_CLIENT_ID
GRAPH_CLIENT_SECRET=CHANGE_ME

# ── Azure AD Single Sign-On ───────────────────────────────────────────────────
# Must exactly match a Redirect URI registered in your Azure AD app registration.
# Register under: App registrations → <your app> → Authentication → Web → Redirect URIs
AZURE_SSO_REDIRECT_URI=http://localhost:3000/api/auth/azure/callback

# Base URL of the frontend (used to redirect after SSO callback)
FRONTEND_URL=http://localhost:5500

{
  "name": "finemark-workspace",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "install:all": "npm install && npm --prefix ./finemark-backend install",
    "dev": "concurrently -n ui,api -c blue,green \"npm run dev:ui\" \"npm run dev:api\"",
    "dev:ui": "http-server ./finemark-ui -p 5500 -c-1",
    "dev:api": "npm --prefix ./finemark-backend run dev",
    "seed": "npm --prefix ./finemark-backend run seed",
    "build:api": "npm --prefix ./finemark-backend run build",
    "start:api": "npm --prefix ./finemark-backend run start"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "http-server": "^14.1.1"
  }
}
